---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Picture from '../components/Picture.astro';

const estrutura = [
  { t: 'Salas privativas', img: 'salas-privativas' },
  { t: 'Áreas compartilhadas', img: 'areas-compartilhadas' },
  { t: 'Rooftop', img: 'rooftop' },
  { t: 'Sala de descanso', img: 'sala-de-descanso' },
  { t: 'Recepção acolhedora', img: 'recepcao-acolhedora' },
  { t: 'Estacionamento', img: 'estacionamento' },
  { t: 'Vestiários', img: 'vestiarios' },
  { t: 'Cozinha completa', img: 'cozinha-completa' },
];
---
<BaseLayout
  title="Sobre o Arya Offices · Polo Tecnológico Sul, Uberlândia"
  description="Conheça o Arya Offices: infraestrutura inteligente para empresas de base tecnológica no Polo Tecnológico Sul de Uberlândia."
  path="/sobre"
>
  <Header active="sobre" />

  <main id="main">
    <!-- Topo: título e, em seguida, o vídeo institucional (destaque da página).
         Fachada leve: só carrega o player do YouTube (domínio nocookie) quando a pessoa clica. -->
    <section class="about-top">
      <div class="container">
        <div class="about-top__head">
          <span class="kicker">Sobre o Arya</span>
          <h1 class="h1 about-hero__title">Infraestrutura inteligente para empresas que não param de evoluir.</h1>
          <nav class="breadcrumb" aria-label="Trilha"><a href="/">Início</a> / <span>Sobre</span></nav>
        </div>

        <div class="video-feature__stage framed">
          <div class="video-player" data-video="yh0WtwOHFjQ">
            <Picture name="video-institucional" alt="" eager width={1280} height={720} />
            <button type="button" class="video-player__play" aria-label="Assistir ao vídeo institucional do Arya Offices">
              <span class="video-player__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg>
              </span>
              <span class="video-player__label">Assistir ao vídeo</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- O conceito -->
    <section class="section section--light">
      <div class="container">
        <div class="about-intro">
          <div class="about-intro__head" data-reveal>
            <span class="kicker">O conceito</span>
          </div>
          <div class="about-intro__body prose" data-reveal style="--reveal-delay:.1s">
            <p class="lead">
              O ARYA nasce da ideia de que o ambiente de trabalho é parte da estratégia de
              crescimento. Por isso, cada espaço foi planejado para oferecer flexibilidade,
              eficiência e conexão com o ecossistema de inovação.
            </p>
            <p>
              Localizado no <strong>Polo Tecnológico Sul de Uberlândia</strong>, o primeiro
              loteamento empresarial público da cidade, o edifício oferece espaços
              personalizáveis que atendem desde startups em expansão até empresas consolidadas
              e filiais que chegam à região.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- A experiência -->
    <section class="section section--dark">
      <div class="container about-split">
        <div class="about-split__media framed" data-reveal>
          <Picture name="experiencia" alt="Ambiente interno do Arya Offices" width={1600} height={1067} />
        </div>
        <div class="about-split__text" data-reveal style="--reveal-delay:.1s">
          <span class="kicker">A experiência</span>
          <h2 class="h2 mt-2">Foco e convivência,<br />lado a lado.</h2>
          <p class="mt-3">
            No ARYA, ambientes de concentração e convivência coexistem de forma natural.
            Salas privativas oferecem a estrutura necessária para o trabalho que exige foco,
            enquanto as áreas compartilhadas favorecem encontros, trocas e colaboração.
          </p>
          <p class="mt-2">
            O rooftop e a sala de descanso criam momentos de pausa que também fazem parte
            de uma rotina produtiva.
          </p>
          <a class="btn btn--outline-gold mt-4" href="/locacoes">Ver modelos de locação</a>
        </div>
      </div>
    </section>

    <!-- Estrutura -->
    <section class="section section--bordo">
      <div class="container">
        <div class="estrutura__head" data-reveal>
          <div>
            <span class="kicker">Estrutura</span>
            <h2 class="h2 mt-2">Tudo no mesmo<br />endereço.</h2>
          </div>
          <p class="estrutura__lead lead">
            Além dos ambientes de trabalho, o ARYA oferece praticidade e conforto para
            empresas, equipes e visitantes.
          </p>
        </div>
        <ul class="estrutura-grid">
          {estrutura.map((item, i) => (
            <li class="estr-card" data-reveal style={`--reveal-delay:${(i * 0.05).toFixed(2)}s`}>
              <div class="estr-card__media">
                <Picture name={item.img} alt={item.t} width={1200} height={800} />
              </div>
              <div class="estr-card__label">
                <span class="estr-card__mark" aria-hidden="true"></span>
                <h3 class="estr-card__t">{item.t}</h3>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--light about-cta">
      <div class="container container--text" data-reveal style="text-align:center">
        <span class="kicker kicker--center">Vamos conversar</span>
        <h2 class="h2 mt-2">Conheça o Arya de perto.</h2>
        <p class="lead mt-2" style="margin-inline:auto;max-width:48ch">
          Agende uma visita guiada e veja como o espaço pode acompanhar o momento da sua empresa.
        </p>
        <a class="btn btn--on-light btn--lg mt-4" href="/contato">Agendar uma visita</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Troca o poster pelo player só no clique: nada do YouTube carrega antes disso.
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    const btn = box.querySelector('button');
    btn?.addEventListener('click', () => {
      const id = box.dataset.video;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = 'Vídeo institucional do Arya Offices';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.classList.add('is-playing');
      box.appendChild(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .about-hero__title { max-width: 20ch; text-wrap: balance; }

  /* Topo: título + vídeo institucional */
  .about-top {
    position: relative; isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 3.5vw, 3rem));
    padding-bottom: var(--section-y);
    background:
      radial-gradient(90% 60% at 20% 0%, rgba(80,21,15,0.45), transparent 70%),
      var(--black);
    color: var(--cream);
  }
  .about-top__head { margin-bottom: clamp(2rem, 3.5vw, 3rem); }
  .about-top .about-hero__title { max-width: 28ch; }
  .about-top__head .h1 { margin-top: 1rem; }
  .about-top .breadcrumb {
    display: flex; gap: 0.6rem; align-items: center;
    font-size: var(--fs-small); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--stone); margin-top: 1.2rem;
  }
  .about-top .breadcrumb a:hover { color: var(--gold); }
  .about-top .breadcrumb span { color: var(--gold); }
  .video-feature__stage { max-width: 1180px; }
  .video-player {
    position: relative; z-index: 1; isolation: isolate; overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--shape-photo);
    background: var(--ink);
  }
  .video-player :global(picture),
  .video-player :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-player :global(img) { transition: transform var(--t-slow) var(--ease); }
  .video-player::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(70% 70% at 50% 50%, rgba(14,6,6,0.1), rgba(14,6,6,0.55));
    transition: opacity var(--t-med) var(--ease);
  }
  .video-player:hover :global(img) { transform: scale(1.03); }
  .video-player:hover::after { opacity: 0.7; }

  .video-player__play {
    position: absolute; inset: 0; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1.1rem; color: var(--cream);
  }
  .video-player__icon {
    display: grid; place-items: center;
    width: clamp(72px, 8vw, 104px); aspect-ratio: 1;
    border-radius: var(--btn-shape);
    background: var(--gold); color: var(--ink);
    box-shadow: 0 18px 44px rgba(0,0,0,0.45);
    transition: transform var(--t-med) var(--ease), background var(--t-med) var(--ease);
  }
  .video-player__icon svg { width: 38%; height: 38%; margin-left: 6%; }
  .video-player__label {
    font-size: 0.74rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(0,0,0,0.6);
  }
  .video-player__play:hover .video-player__icon,
  .video-player__play:focus-visible .video-player__icon { transform: scale(1.06); background: var(--gold-soft); }
  .video-player__play:focus-visible { outline-offset: -6px; }

  .video-player.is-playing :global(picture),
  .video-player.is-playing::after,
  .video-player.is-playing .video-player__play { display: none; }
  .video-player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .about-intro { display: grid; grid-template-columns: 0.4fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  .about-intro__head { display: flex; flex-direction: column; gap: 0.8rem; }

  .about-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .about-split__media :global(img) { width: 100%; height: clamp(420px, 50vw, 640px); object-fit: cover; display: block; }
  .about-split__text .kicker { margin-top: 0.5rem; }

  /* Estrutura */
  .estrutura__head {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end; margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .estrutura__lead { color: var(--stone); }
  .estrutura-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.85rem, 1.4vw, 1.25rem);
  }
  .estr-card {
    position: relative; isolation: isolate; overflow: hidden;
    border-radius: var(--card-shape);
    border: 1px solid var(--line-gold-soft);
    transition: border-color var(--t-med) var(--ease), transform var(--t-med) var(--ease);
  }
  .estr-card__media { overflow: hidden; }
  .estr-card__media :global(img) {
    width: 100%; height: clamp(175px, 20vw, 230px); object-fit: cover; display: block;
    transition: transform var(--t-slow) var(--ease);
  }
  .estr-card:hover { border-color: var(--line-gold); transform: translateY(-3px); }
  .estr-card:hover .estr-card__media :global(img) { transform: scale(1.06); }
  .estr-card__label {
    position: absolute; inset-inline: 0; bottom: 0; z-index: 1;
    display: flex; align-items: center; gap: 0.65rem;
    padding: clamp(1.4rem, 2.4vw, 2rem) clamp(0.9rem, 1.4vw, 1.2rem) clamp(0.85rem, 1.3vw, 1.05rem);
    background: linear-gradient(180deg, transparent, rgba(14,6,6,0.5) 45%, rgba(14,6,6,0.9));
  }
  .estr-card__mark { flex: none; width: 20px; height: 2px; background: var(--gold); }
  .estr-card__t {
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.12rem); font-weight: 500;
    color: var(--cream); letter-spacing: 0.01em; line-height: 1.2;
  }

  @media (max-width: 880px) {
    .about-intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-split { grid-template-columns: 1fr; }
    .about-split__media { order: -1; }
    .estrutura__head { grid-template-columns: 1fr; align-items: start; gap: 1rem; }
    .estrutura-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .video-player__icon { width: 56px; }
    .video-player__play { gap: 0.7rem; }
    .video-player__label { font-size: 0.66rem; }
    .estrutura-grid { grid-template-columns: 1fr; gap: 0.9rem; }
    .estr-card__media :global(img) { height: clamp(210px, 58vw, 300px); }
    .estr-card__label { padding: clamp(1.6rem, 6vw, 2.2rem) clamp(1rem, 4vw, 1.4rem) clamp(1rem, 3.5vw, 1.3rem); }
  }
</style>
