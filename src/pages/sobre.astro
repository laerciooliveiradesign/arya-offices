---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Picture from '../components/Picture.astro';

const estrutura = [
  'Salas privativas',
  'Áreas compartilhadas',
  'Rooftop',
  'Sala de descanso',
  'Recepção acolhedora',
  'Estacionamento',
  'Vestiários',
  'Cozinha completa',
];
---
<BaseLayout
  title="Sobre o Arya Offices · Polo Tecnológico Sul, Uberlândia"
  description="Conheça o Arya Offices: infraestrutura inteligente para empresas de base tecnológica no Polo Tecnológico Sul de Uberlândia."
  path="/sobre"
>
  <Header active="sobre" />

  <main id="main">
    <!-- Page hero -->
    <section class="page-hero">
      <div class="page-hero__media"><Picture name="Enscape_2025-07-25-17-55-22" alt="Fachada do edifício Arya Offices" eager width={1920} height={1080} /></div>
      <div class="page-hero__veil"></div>
      <div class="container page-hero__inner">
        <span class="kicker">Sobre o Arya</span>
        <h1 class="h1 about-hero__title">Infraestrutura inteligente para empresas que não param de evoluir.</h1>
        <nav class="breadcrumb" aria-label="Trilha"><a href="/home">Início</a> / <span>Sobre</span></nav>
      </div>
    </section>

    <!-- O conceito -->
    <section class="section section--light">
      <div class="container">
        <div class="about-intro">
          <div class="about-intro__head" data-reveal>
            <span class="kicker">O conceito</span>
          </div>
          <div class="about-intro__body prose" data-reveal style="--reveal-delay:.1s">
            <p class="lead">
              O ARYA nasce da ideia de que o ambiente de trabalho é parte da estratégia de
              crescimento. Por isso, cada espaço foi planejado para oferecer flexibilidade,
              eficiência e conexão com o ecossistema de inovação.
            </p>
            <p>
              Localizado no <strong>Polo Tecnológico Sul de Uberlândia</strong>, o primeiro
              loteamento empresarial público da cidade, o edifício oferece espaços
              personalizáveis que atendem desde startups em expansão até empresas consolidadas
              e filiais que chegam à região.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- A experiência -->
    <section class="section section--dark">
      <div class="container about-split">
        <div class="about-split__media framed" data-reveal>
          <Picture name="Enscape_2025-07-25-18-22-27" alt="Ambiente interno do Arya Offices" width={1100} height={1320} />
        </div>
        <div class="about-split__text" data-reveal style="--reveal-delay:.1s">
          <span class="kicker">A experiência</span>
          <h2 class="h2 mt-2">Foco e convivência,<br />lado a lado.</h2>
          <p class="mt-3">
            No ARYA, ambientes de concentração e convivência coexistem de forma natural.
            Salas privativas oferecem a estrutura necessária para o trabalho que exige foco,
            enquanto as áreas compartilhadas favorecem encontros, trocas e colaboração.
          </p>
          <p class="mt-2">
            O rooftop e a sala de descanso criam momentos de pausa que também fazem parte
            de uma rotina produtiva.
          </p>
          <a class="btn btn--outline-gold mt-4" href="/locacoes">Ver modelos de locação</a>
        </div>
      </div>
    </section>

    <!-- Estrutura -->
    <section class="section section--bordo">
      <div class="container">
        <div class="estrutura__head" data-reveal>
          <div>
            <span class="kicker">Estrutura</span>
            <h2 class="h2 mt-2">Tudo no mesmo<br />endereço.</h2>
          </div>
          <p class="estrutura__lead lead">
            Além dos ambientes de trabalho, o ARYA oferece praticidade e conforto para
            empresas, equipes e visitantes.
          </p>
        </div>
        <ul class="estrutura-grid" data-reveal>
          {estrutura.map((item) => (
            <li class="estrutura__item">
              <span class="estrutura__mark" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--light about-cta">
      <div class="container container--text" data-reveal style="text-align:center">
        <span class="kicker kicker--center">Vamos conversar</span>
        <h2 class="h2 mt-2">Conheça o Arya de perto.</h2>
        <p class="lead mt-2" style="margin-inline:auto;max-width:48ch">
          Agende uma visita guiada e veja como o espaço pode acompanhar o momento da sua empresa.
        </p>
        <a class="btn btn--on-light btn--lg mt-4" href="/contato">Agendar uma visita</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-hero__title { max-width: 20ch; text-wrap: balance; }

  .about-intro { display: grid; grid-template-columns: 0.4fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  .about-intro__head { display: flex; flex-direction: column; gap: 0.8rem; }

  .about-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .about-split__media :global(img) { width: 100%; height: clamp(420px, 50vw, 640px); object-fit: cover; display: block; }
  .about-split__text .kicker { margin-top: 0.5rem; }

  /* Estrutura */
  .estrutura__head {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end; margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .estrutura__lead { color: var(--stone); }
  .estrutura-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    border: 1px solid var(--line-cream-soft); background: var(--line-cream-soft);
    border-radius: var(--card-shape); overflow: hidden;
  }
  .estrutura__item {
    display: flex; align-items: center; gap: 0.9rem;
    background: var(--bordo-deep);
    padding: clamp(1.4rem, 2.2vw, 1.9rem) clamp(1.25rem, 1.8vw, 1.75rem);
    font-size: 1.02rem; color: var(--cream);
    transition: background var(--t-med) var(--ease);
  }
  .estrutura__item:hover { background: var(--bordo); }
  .estrutura__mark { flex: none; width: 22px; height: 2px; background: var(--gold); }

  @media (max-width: 880px) {
    .about-intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-split { grid-template-columns: 1fr; }
    .about-split__media { order: -1; }
    .estrutura__head { grid-template-columns: 1fr; align-items: start; gap: 1rem; }
    .estrutura-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .estrutura-grid { grid-template-columns: 1fr; }
  }
</style>
