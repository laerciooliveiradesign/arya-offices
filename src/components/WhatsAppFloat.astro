---
/* Botão flutuante de WhatsApp.
   Não é o widget verde genérico: é uma placa de concierge na linguagem da casa —
   bordô profundo, hairline dourada, canto reto na assinatura e o mesmo
   preenchimento-que-sobe dos .btn do site.
   Comportamento: entra depois da primeira dobra (o hero já tem CTA próprio),
   recua acima do aviso de cookies enquanto ele estiver aberto e desaparece
   junto com o menu mobile. */
const wa =
  'https://api.whatsapp.com/send/?phone=5534997730688&text&type=phone_number&app_absent=0&utm_source=site';
const label = 'Fale no WhatsApp';
---

<a
  class="wa-float"
  href={wa}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-wa-float
>
  <span class="wa-float__mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
      />
    </svg>
  </span>
  <span class="wa-float__label">{label}</span>
</a>

<style>
  .wa-float {
    --wa-inset: clamp(16px, 2.2vw, 30px);

    position: fixed;
    right: var(--wa-inset);
    bottom: calc(var(--wa-inset) + var(--wa-lift, 0px));
    z-index: 80;

    display: inline-flex;
    align-items: center;
    height: 58px;
    padding-inline: 18px;

    color: var(--gold);
    background: var(--bordo-deep);
    border: 1px solid var(--line-gold);
    /* Forma da marca: cantos suaves com o canto reto de assinatura embaixo-esquerda. */
    border-radius: var(--r) var(--r) var(--r) 0;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.5);

    overflow: hidden;
    isolation: isolate;

    /* Escondido até passar a primeira dobra. */
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.96);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      visibility 0.6s,
      bottom 0.45s var(--ease),
      color var(--t-med) var(--ease),
      border-color var(--t-med) var(--ease);
  }
  .wa-float.is-in {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* Mesmo preenchimento-que-sobe dos .btn: acima do fundo, abaixo do conteúdo. */
  .wa-float::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: translateY(102%);
    transition: transform var(--t-med) var(--ease);
  }
  .wa-float:hover,
  .wa-float:focus-visible {
    color: var(--ink);
    border-color: var(--gold);
  }
  .wa-float:hover::before,
  .wa-float:focus-visible::before {
    transform: translateY(0);
  }

  .wa-float__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
  }
  .wa-float__mark svg {
    width: 100%;
    height: 100%;
  }

  /* O rótulo abre a partir da marca, puxando a placa para a esquerda. */
  .wa-float__label {
    max-width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
    transition:
      max-width 0.55s var(--ease),
      margin-left 0.55s var(--ease),
      opacity 0.35s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .wa-float:hover .wa-float__label {
      max-width: 14rem;
      margin-left: 0.85rem;
      opacity: 1;
    }
  }
  .wa-float:focus-visible .wa-float__label {
    max-width: 14rem;
    margin-left: 0.85rem;
    opacity: 1;
  }

  /* Sai de cena junto com o menu mobile fullscreen e enquanto o aviso de
     cookies estiver ocupando o canto em telas estreitas. */
  :global(body.menu-open) .wa-float,
  .wa-float.is-blocked {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .wa-float {
      height: 54px;
      padding-inline: 16px;
    }
  }
</style>

<script>
  (function () {
    const el = document.querySelector('[data-wa-float]');
    if (!el) return;

    /* 1 · entra depois da primeira dobra — o hero de cada página já tem o seu CTA.
       Página que não rola mostra o botão de cara. */
    function aoRolar() {
      const limite = Math.min(window.innerHeight * 0.6, 520);
      const semRolagem =
        document.documentElement.scrollHeight <= window.innerHeight + 80;
      el.classList.toggle('is-in', semRolagem || window.scrollY > limite);
    }

    /* 2 · convive com o aviso de cookies, que mora no mesmo canto.
       Em tela larga o botão sobe acima dele (altura medida, porque o aviso
       quebra linha). Em tela estreita o aviso ocupa quase tudo: aí o botão
       espera a escolha em vez de ser empurrado para fora da tela. */
    const consent = document.querySelector('[data-consent]');
    function ajustarRecuo() {
      const aberto = !!consent && !consent.hidden;
      const h = aberto ? consent.getBoundingClientRect().height + 14 : 0;
      const cabe = h + 90 < window.innerHeight * 0.55;
      el.classList.toggle('is-blocked', aberto && !cabe);
      document.documentElement.style.setProperty(
        '--wa-lift',
        (aberto && cabe ? h : 0) + 'px'
      );
    }

    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
    window.addEventListener('resize', aoRolar);

    if (consent) {
      ajustarRecuo();
      new MutationObserver(ajustarRecuo).observe(consent, {
        attributes: true,
        attributeFilter: ['hidden'],
      });
      window.addEventListener('resize', ajustarRecuo);
    }
  })();
</script>
