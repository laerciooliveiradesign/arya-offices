---
// Medição do site: Meta Pixel + Google Analytics 4, só depois do aceite do visitante (LGPD).
// Sem aceite, nenhum script de terceiro carrega. A escolha fica no navegador (localStorage).
//
// Eventos:
//  - PageView (Pixel) / page_view (GA4): toda página
//  - Contact: clique em link de WhatsApp
//  - Lead: formulário de contato enviado com sucesso (chamado em contato.astro)
const PIXEL_ID = '1462808052390230'; // "ARYA Offices - Site", portfólio ARYA Offices
const GA_ID = ''; // G-XXXXXXXXXX da propriedade GA4 (preencher quando criar)
---
<div class="consent" data-consent hidden role="region" aria-label="Aviso de cookies">
  <p>
    Usamos cookies para medir as visitas e melhorar nossos anúncios.
    Saiba mais na <a href="/privacidade">política de privacidade</a>.
  </p>
  <div class="consent__actions">
    <button type="button" class="consent__btn consent__btn--ghost" data-consent-no>Recusar</button>
    <button type="button" class="consent__btn" data-consent-yes>Aceitar</button>
  </div>
</div>

<script is:inline define:vars={{ PIXEL_ID, GA_ID }}>
  (function () {
    var KEY = 'arya_consent';
    var loaded = false;
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

    function load() {
      if (loaded) return;
      loaded = true;
      if (PIXEL_ID) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', PIXEL_ID);
        window.fbq('track', 'PageView');
      }
      if (GA_ID) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', GA_ID);
      }
    }

    // usado pelas páginas: window.aryaTrack('Lead') / ('Contact')
    window.aryaTrack = function (event) {
      if (!loaded) return;
      if (window.fbq) window.fbq('track', event);
      if (window.gtag) window.gtag('event', event === 'Lead' ? 'generate_lead' : 'contact');
    };

    var banner = document.querySelector('[data-consent]');
    var choice = read();
    if (choice === 'sim') load();
    else if (!choice && banner) banner.hidden = false;

    banner && banner.querySelector('[data-consent-yes]').addEventListener('click', function () {
      save('sim'); banner.hidden = true; load();
    });
    banner && banner.querySelector('[data-consent-no]').addEventListener('click', function () {
      save('nao'); banner.hidden = true;
    });

    // clique para o WhatsApp conta como contato
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (a && /wa\.me|whatsapp\.com/.test(a.getAttribute('href'))) window.aryaTrack('Contact');
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 90;
    max-width: 560px;
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    padding: 16px 18px;
    background: var(--bordo-deep);
    color: var(--cream);
    border: 1px solid var(--line-gold-soft);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 260px; margin: 0; }
  .consent a { color: var(--gold-soft); text-decoration: underline; text-underline-offset: 3px; }
  .consent__actions { display: flex; gap: 8px; margin-left: auto; }
  .consent__btn {
    font: inherit;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--gold);
    background: var(--gold);
    color: var(--ink);
    cursor: pointer;
  }
  .consent__btn--ghost { background: transparent; color: var(--cream); border-color: var(--line-cream); }
  .consent__btn:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: 2px; }
</style>
